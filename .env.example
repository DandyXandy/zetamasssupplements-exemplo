# Copia este archivo como .env.local y completa con tus credenciales reales.
# Credenciales de Mercado Pago: mercadopago.com.pe/developers → Tus
# integraciones → tu app → "Credenciales de prueba" (o de producción cuando
# el cliente apruebe el sitio).
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Dominio público del sitio (usado para las back_urls de Mercado Pago).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos del panel admin. Postgres administrado (ej. Neon, Supabase).
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Acceso al panel admin (/admin).
ADMIN_EMAIL=
ADMIN_PASSWORD=
AUTH_SECRET=

# Vercel Blob (Storage → Blob en el dashboard de Vercel) para las imágenes
# subidas desde el panel admin.
BLOB_READ_WRITE_TOKEN=
